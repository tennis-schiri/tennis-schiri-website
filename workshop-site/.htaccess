# TENNIS-SCHIRI Workshop — geschuetzter Bereich auf ALL-INKL/Apache
Options -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
RewriteEngine On
# Alte wie neue ungeschuetzte Pfade stets durch die PHP-Zugangskontrolle leiten.
RewriteRule ^_private(?:/|$) - [F,L,NC]
RewriteRule ^slides/(slide-[0-9]{3}\.webp)$ resource.php?path=slides/$1 [QSA,L,NC]
RewriteRule ^media/(clip-[0-9]{3}\.mp4)$ resource.php?path=media/$1 [QSA,L,NC]
RewriteRule ^slides\.json$ resource.php?path=slides.json [QSA,L,NC]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "same-origin"
</IfModule>
